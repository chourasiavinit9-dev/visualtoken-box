# VisualBox — Environment Configuration
# Copy this file to .env and edit it to point VisualBox at your own LLM.
# Usage: cp .env.example .env

# ── Model Selection ────────────────────────────────────────────────────────────
# Set to any HuggingFace model ID. Examples below — uncomment one:

VISUALBOX_MODEL=unsloth/gemma-2-2b-it        # Default — works with run_server.py

# VISUALBOX_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct   # CPU-friendly, ~270MB
# VISUALBOX_MODEL=google/gemma-3-4b-it                   # Requires: huggingface-cli login
# VISUALBOX_MODEL=mistralai/Mistral-7B-Instruct-v0.3     # 7B, good balance
# VISUALBOX_MODEL=meta-llama/Llama-3.2-3B-Instruct       # Requires: huggingface-cli login
# VISUALBOX_MODEL=microsoft/Phi-3.5-mini-instruct        # Lightweight, fast
# VISUALBOX_MODEL=Qwen/Qwen2.5-7B-Instruct               # Strong multilingual
# VISUALBOX_MODEL=gpt2                                    # Tiny, instant test (no login)

# ── Hardware ───────────────────────────────────────────────────────────────────
DEVICE=auto   # auto | cuda | mps | cpu

# ── Generation Defaults (overridable per request in the UI) ───────────────────
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=10

# ── System Prompt ──────────────────────────────────────────────────────────────
VISUALBOX_SYSTEM_PROMPT=You are a helpful, concise assistant.

# ── HuggingFace Auth (for gated models like Gemma, Llama 3) ───────────────────
# HF_TOKEN=hf_your_token_here
